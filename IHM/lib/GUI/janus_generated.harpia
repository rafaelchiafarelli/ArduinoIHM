message pwm{
    string ch0_state_label;
    int ch0_enabled;
    int ch0_inverting;
    int ch0_duty_percent;
    string ch0_inverting_label;
    string ch1_state_label;
    int ch1_enabled;
    int ch1_inverting;
    int ch1_duty_percent;
    string ch1_inverting_label;
    string ch2_state_label;
    int ch2_a_enabled;
    int ch2_a_duty_percent;
    int ch2_b_enabled;
    int ch2_b_duty_percent;
    int ch2_c_enabled;
    int ch2_c_duty_percent;
    string ch3_state_label;
    int ch3_a_enabled;
    int ch3_a_duty_percent;
    int ch3_b_enabled;
    int ch3_b_duty_percent;
    int ch3_c_enabled;
    int ch3_c_duty_percent;
};

message bus_status{
    int can0_enabled;
    int64 can0_id;
    int can0_dlc;
    int can0_extended;
    int64 can0_period_ms;
    string can0_repeat_label;
    int can0_byte_index;
    int can0_byte_value;
    int can1_enabled;
    int64 can1_id;
    int can1_dlc;
    int can1_extended;
    int64 can1_period_ms;
    string can1_repeat_label;
    int can1_byte_index;
    int can1_byte_value;
    int rs485_enabled;
    int rs485_length;
    int64 rs485_period_ms;
    string rs485_repeat_label;
    int rs485_byte_index;
    int rs485_byte_value;
};

message relay{
    int relay_0;
    int relay_1;
    int relay_2;
    int relay_3;
    int relay_4;
    int relay_5;
    int relay_6;
    int relay_7;
};
