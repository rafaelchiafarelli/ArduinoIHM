message pwm{
    int ch0_enabled;
    int ch0_inverting;
    string ch0_mode_icon;
    string ch0_state_label;
    int ch0_duty_percent;
    int ch1_enabled;
    int ch1_inverting;
    string ch1_mode_icon;
    string ch1_state_label;
    int ch1_duty_percent;
    int ch2_a_enabled;
    int ch2_a_duty_percent;
    int ch2_b_enabled;
    int ch2_b_duty_percent;
    int ch2_c_enabled;
    int ch2_c_duty_percent;
    string ch2_mode_icon;
    string ch2_state_label;
    int ch3_a_enabled;
    int ch3_a_duty_percent;
    int ch3_b_enabled;
    int ch3_b_duty_percent;
    int ch3_c_enabled;
    int ch3_c_duty_percent;
    string ch3_mode_icon;
    string ch3_state_label;
};

message bus_status{
    int can0_enabled;
    int can0_id;
    int can0_dlc;
    int can0_extended;
    int can1_enabled;
    int can1_id;
    int can1_dlc;
    int can1_extended;
    int rs485_enabled;
    int rs485_length;
    int rs485_period_ms;
};

message relay{
    int relay_0;
    int relay_1;
    int relay_2;
    int relay_3;
    int relay_4;
    int relay_5;
    int relay_6;
    int relay_7;
};
