<mxfile host="app.diagrams.net">
  <diagram name="GUI Render Pipeline &amp; Timing (current state)" id="gui-render-pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="GUI Render Pipeline &amp; Timing -- current state, 2026-08-15" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Scoped to how a frame gets drawn and where the housekeeping rotation pin's value currently goes -- not a proposal, just what exists today. See docs/architecture.drawio for the whole-project map." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1400" y="10" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="Wired end-to-end, active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="40" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="UI layer (lib/GUI, lib/Elements)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="72" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="Vendored, unmodified (Display/GFX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="104" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="Gap: value exists but doesn't reach this" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="136" width="260" height="26" as="geometry" />
        </mxCell>

        <!-- ISR row -->
        <mxCell id="isr2" value="ISR(TIMER2_COMPA_vect)&#10;~1.008ms system tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="550" y="80" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cadTick" value="every tick (~1ms)" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="160" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cad25" value="every 25th tick (~25ms)" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="220" height="20" as="geometry" />
        </mxCell>

        <mxCell id="binIn" value="BinaryInputs.fast_handler()&#10;15 input pins -&gt; bMap&#10;(bit4=PA0 rotation, bit5=PA2 charging)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="185" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rotMs" value="RotaryEncoder.ms_handler(bMap)&#10;quadrature decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="185" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="bMapGlobal" value="volatile uint16_t bMap&#10;(ISR writes, main() reads -- the project's&#10;only cross-context shared state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=3;" vertex="1" parent="1">
          <mxGeometry x="150" y="275" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- superloop container -->
        <mxCell id="superloop" value="main() while(1) superloop -- no fixed cadence, gated only by how long each pass takes" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="1010" height="480" as="geometry" />
        </mxCell>

        <mxCell id="mavlinkPoll" value="mavlinkComms.poll()&#10;receives CAN_SIGNAL_CONFIG /&#10;RS485_SIGNAL_CONFIG from PC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="400" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="btnMapNode" value="buildButtonMap(bMap) -&gt; btnMap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="475" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="getDirNode" value="rotaryEncoders.getDirection() x3&#10;-&gt; dir[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="535" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rotExtract" value="rotation = (bMap&gt;&gt;4) &amp; 0x01&#10;charging = (bMap&gt;&gt;5) &amp; 0x01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="600" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="guiUpdate" value="GUI.update(dir, btnMap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="475" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tabSelectorNode" value="TabSelector&#10;(PWM / SERIAL / Output)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="550" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="activeScreen" value="Active screen (per TabSelector):&#10;PWMScreen | BusStatusScreen | RelayScreen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="615" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="statusBarNode" value="StatusBar.update()&#10;(always drawn, any tab)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="550" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="widgetsNode" value="Widgets: Label / LED / Icon .update()&#10;dirty-flag (isShown) + BlinkAnimator&#10;gated draws -- partial redraw only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="700" width="330" height="65" as="geometry" />
        </mxCell>

        <mxCell id="timeBlock" value="if (timeCounter &gt;= 100):&#10;mavlinkComms.sendBoardState(&#10;  ..., rotation, charging, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="400" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- outside superloop: boot-time + Display -->
        <mxCell id="guiSetup" value="GUI.setup()&#10;boot-time only, not part&#10;of the superloop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="400" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pcApp" value="PC app (IHM-PCApp)&#10;over MAVLink / USART0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="475" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="setRotationCall" value="tft-&gt;setRotation(0)&#10;called ONCE, at boot -- never&#10;called again anywhere else" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="545" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="display" value="Display / GFX&#10;parallel-TFT driver&#10;coordinate system fixed by whatever&#10;rotation was set at setup time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1170" y="625" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="drawPrimitives" value="fillRect / println / fillCircle /&#10;drawFastHLine / drawRGBBitmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="715" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gapNote" value="GAP: rotation never reaches&#10;Display::setRotation() at runtime.&#10;Its only effect today is being mirrored&#10;into outgoing MAVLink telemetry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="490" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="isr2" target="binIn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="isr2" target="rotMs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="binIn" target="bMapGlobal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bMapGlobal" target="btnMapNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bMapGlobal" target="rotExtract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="rotMs" target="getDirNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="btnMapNode" target="guiUpdate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="getDirNode" target="guiUpdate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="guiUpdate" target="tabSelectorNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="tabSelectorNode" target="activeScreen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="guiUpdate" target="statusBarNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="activeScreen" target="widgetsNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="statusBarNode" target="widgetsNode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="widgetsNode" target="display"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="display" target="drawPrimitives"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="rotExtract" target="timeBlock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="timeBlock" target="pcApp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="rotExtract" target="gapNote"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="guiSetup" target="setRotationCall"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="setRotationCall" target="display"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
