        <mxCell id="busio" value="BusIO (vendored)&#10;I2CDevice / SPIDevice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="910" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="avr" value="AVR SFRs: PORTx / DDRx / PINx, TCCRx / OCRx, UDR0, TWCR..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="990" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- Display, vendored, off to the side -->
        <mxCell id="display" value="Display / GFX&#10;parallel-TFT driver (mcufriend_kbv-style)&#10;register-direct on this target, delay() = boot-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="710" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="displayDead" value="SPITFT.cpp / GrayOLED.cpp&#10;vendored, unreferenced, dead code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1020" y="790" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Timer4 conflict callout -->
        <mxCell id="timer4Conflict" value="Timer4 resource conflict:&#10;PWM channel 3 (OC4A/B/C, live today) vs.&#10;planned ServoMotor use of OCR4A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="1050" width="420" height="55" as="geometry" />
