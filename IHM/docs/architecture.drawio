<mxfile host="app.diagrams.net">
  <diagram name="ArduinoIHM Architecture" id="arduinoihm-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ArduinoIHM Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1400" y="10" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="Wired end-to-end, active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="40" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="Gap: exists but not called / not wired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="72" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="HAL / shared register-access foundation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="104" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="UI layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="136" width="260" height="26" as="geometry" />
        </mxCell>

        <!-- ISR row -->
        <mxCell id="isr2" value="ISR(TIMER2_COMPA_vect)&#10;~1.008ms system tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="isr1" value="ISR(TIMER1_COMPA_vect)&#10;present, empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1020" y="60" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- cadence labels -->
        <mxCell id="cad1" value="every tick (~1ms)" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="170" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cad25" value="every 25th tick (~25ms)" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cad10" value="every 10th tick — unused slot" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="860" y="170" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- modules driven by timer2 tick -->
        <mxCell id="binIn" value="BinaryInput&#10;.fast_handler()&#10;15 input pins -> bMap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="relaySlow" value="MultiOutput.slow_handler()&#10;-> Relay.ultra_slow_handler()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="commsFast" value="Comms.fast_handler()&#10;parses IF able_to_parse is set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="270" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rotMs" value="RotaryEncoder.ms_handler(bMap)&#10;quadrature decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- gap modules -->
        <mxCell id="servoTimer" value="ServoMotor.timer_handler()&#10;writes OCR4A — NEVER CALLED&#10;(wrong ISR vector even if wired)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="200" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="motorFast" value="MotorDC.fast_handler()&#10;stepper microstepping — NEVER CALLED&#10;(both call sites commented out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="280" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="recvGap" value="SerialCommunication.receive()&#10;framing parser entry point&#10;NEVER CALLED by any ISR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="360" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- superloop container -->
        <mxCell id="superloop" value="main() while(1) superloop — no fixed cadence" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="160" y="460" width="1160" height="330" as="geometry" />
        </mxCell>
        <mxCell id="btnMap" value="buildButtonMap(bMap)&#10;-> btnMap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="500" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="getDir" value="RotaryEncoder&#10;.getDirection() x3 -> dir[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="570" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gui" value="GUI.update(dir, btnMap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="530" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pwmScreen" value="Elements: PWMScreen&#10;(PWMSimplex x2, PWMComplex x2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="610" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="relayScreen" value="Elements: RelayScreen&#10;(RelayElement x8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="610" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pwmStateMachine" value="PWMStateMachine&#10;(cursor/field state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="680" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pwmMod" value="PWM.setupPWMChannel0..3&#10;Timer1/3/4/5 OCRx registers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="740" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="relayMod" value="Relay.setRelay()&#10;-&gt; BinaryOutputs 0-7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="740" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="commsParse" value="Comms.Parse()/decode()&#10;-&gt; voltage0 / voltage1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="530" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dac0" value="MCP4725 dac0 (0x62)&#10;.setVoltage(voltage1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="610" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dac1" value="MCP4725 dac1 (0x63)&#10;.setVoltage(voltage0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="610" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- second BinaryOutputs box, below superloop, feeding all output modules -->
        <mxCell id="binOutputs" value="BinaryOutputs&#10;20-slot register-direct pin table&#10;0-7 Relay | 8-13 MotorDC | 8-17 ServoMotor (overlap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="820" width="420" height="60" as="geometry" />
