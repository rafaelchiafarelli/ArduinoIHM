        <mxCell id="regio" value="HAL/RegisterIO.h — Reg8/Reg16&#10;(single register handle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="910" width="200" height="50" as="geometry" />
