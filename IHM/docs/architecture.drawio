        <mxCell id="ports" value="Ports.h — port_type&#10;(register ptr + set/reset mask)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
